SUPABASE_URL=your_supabase_project_url
# Use the SERVICE_ROLE key (Project Settings -> API -> service_role), NOT the anon
# key. The backend does its own JWT auth and relies on service_role to bypass the
# deny-all RLS that locks the public REST API. Keep this key server-side only.
SUPABASE_KEY=your_supabase_service_role_key
JWT_SECRET=at_least_32_chars__python -c "import secrets; print(secrets.token_urlsafe(48))"
# How long an access token lasts. Short on purpose: the refresh token below
# is what keeps a session alive, and unlike a JWT it can be revoked.
JWT_EXPIRE_HOURS=1
# How long a signed-out-of-nothing device stays signed in.
REFRESH_TOKEN_DAYS=30
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Exact origins, comma separated. No trailing slash: a browser never sends one
# in the Origin header, so a value ending in / matches nothing and every
# request is refused by CORS.
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
DEBUG=false
